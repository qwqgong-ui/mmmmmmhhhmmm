diff --git a/monitor_address_update_test.go b/monitor_address_update_test.go
new file mode 100644
--- /dev/null
+++ b/monitor_address_update_test.go
@@ -0,0 +1,42 @@
+//go:build linux
+
+package tun
+
+import (
+	"testing"
+	"time"
+
+	"github.com/sagernet/netlink"
+)
+
+func TestAddressUpdatesInvalidateWithoutRouteThrottle(t *testing.T) {
+	m := &networkUpdateMonitor{addrUpdate: make(chan netlink.AddrUpdate), close: make(chan struct{})}
+	events := make(chan struct{}, 100)
+	m.RegisterCallback(func() { events <- struct{}{} })
+	done := make(chan struct{})
+	go func() { defer close(done); m.loopAddressUpdate() }()
+	for i := 0; i < 100; i++ {
+		select {
+		case m.addrUpdate <- netlink.AddrUpdate{}:
+		case <-time.After(time.Second):
+			t.Fatal("address update throttled")
+		}
+	}
+	for i := 0; i < 100; i++ {
+		select {
+		case <-events:
+		case <-time.After(time.Second):
+			t.Fatal("address invalidation lost")
+		}
+	}
+	if err := m.Close(); err != nil { t.Fatal(err) }
+	select { case <-done: case <-time.After(time.Second): t.Fatal("address monitor leaked") }
+}
+
+func TestAddressUpdateChannelClosureStopsLoop(t *testing.T) {
+	m := &networkUpdateMonitor{addrUpdate: make(chan netlink.AddrUpdate), close: make(chan struct{})}
+	close(m.addrUpdate)
+	done := make(chan struct{})
+	go func() { defer close(done); m.loopAddressUpdate() }()
+	select { case <-done: case <-time.After(time.Second): t.Fatal("closed address channel spins") }
+}
